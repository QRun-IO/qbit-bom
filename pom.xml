<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>
   <groupId>com.kingsrook</groupId>
   <artifactId>qbit-build-parent</artifactId>
   <version>${revision}</version>
   <packaging>pom</packaging>

   <modules>
      <module>qbit-guardrails</module>
   </modules>

   <name>QRunIO QBit Build Parent</name>
   <description>Central build configuration and publishing settings for all QRunIO QBit projects published via our CICD pipelines.</description>
   <url>https://github.com/Kingsrook/qbit-bom</url>
   <licenses>
      <license>
         <name>GNU Affero General Public License v3.0</name>
         <url>https://www.gnu.org/licenses/agpl-3.0-standalone.html</url>
         <distribution>repo</distribution>
      </license>
   </licenses>
   <scm>
      <connection>scm:git:https://github.com/Kingsrook/qbit-bom.git</connection>
      <developerConnection>scm:git:ssh://git@github.com/Kingsrook/qbit-bom.git</developerConnection>
      <url>https://github.com/Kingsrook/qbit-bom</url>
      <tag>HEAD</tag>
   </scm>
   <developers>
      <developer>
         <id>kingsrook</id>
         <name>Kingsrook, LLC</name>
         <email>pub@qrun.io</email>
         <organization>Kingsrook, LLC</organization>
         <organizationUrl>https://qrun.io</organizationUrl>
      </developer>
   </developers>

   <properties>
      <java.version>21</java.version>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

      <!-- use revision property in children -->
      <revision>2.1.1</revision>
      <!-- Do not use revision here: children override it with their own version. -->
      <qbit.guardrails.version>2.1.0</qbit.guardrails.version>
      <qbit.guardrails.enforce>false</qbit.guardrails.enforce>
      <qbit.guardrails.allowedQbitArtifacts>com.kingsrook.qbits:qbit-object-storage,com.kingsrook.qbits:qbit-email,com.kingsrook.qbits:*-api</qbit.guardrails.allowedQbitArtifacts>
      <qbit.guardrails.allowedApiPackages>com.kingsrook.qbits.objectstorage.api,com.kingsrook.qbits.email.api,com.kingsrook.qbits.assistant.spi</qbit.guardrails.allowedApiPackages>
      <qbit.guardrails.strictUiApiRoutes>false</qbit.guardrails.strictUiApiRoutes>
   </properties>

   <!-- Common dependency BOMs -->
   <dependencyManagement>

      <dependencies>
         <dependency>
            <groupId>com.kingsrook.qqq</groupId>
            <artifactId>qqq-bom-pom</artifactId>
            <version>4.0.0</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>

         <dependency>
            <groupId>org.junit</groupId>
            <artifactId>junit-bom</artifactId>
            <version>6.0.1</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>
      </dependencies>

   </dependencyManagement>

   <build>
      <pluginManagement>
         <plugins>
            <!-- Compiler -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-compiler-plugin</artifactId>
               <version>3.11.0</version>
               <configuration>
                  <source>${java.version}</source>
                  <target>${java.version}</target>
               </configuration>
            </plugin>
            <!-- Add other shared plugin configs here if desired -->
         </plugins>
      </pluginManagement>
   </build>

   <profiles>
      <profile>
         <id>qbit-guardrails</id>
         <activation>
            <property><name>!qbit.guardrails.skip</name></property>
         </activation>
         <dependencies>
            <dependency>
               <groupId>com.kingsrook</groupId>
               <artifactId>qbit-guardrails</artifactId>
               <version>${qbit.guardrails.version}</version>
               <scope>test</scope>
            </dependency>
         </dependencies>
         <build>
            <pluginManagement>
               <plugins>
                  <plugin>
                     <groupId>org.apache.maven.plugins</groupId>
                     <artifactId>maven-surefire-plugin</artifactId>
                     <version>3.5.6</version>
                     <configuration>
                        <dependenciesToScan combine.children="append">
                           <dependency>com.kingsrook:qbit-guardrails</dependency>
                        </dependenciesToScan>
                        <systemPropertyVariables>
                           <qbit.guardrails.basedir>${project.basedir}</qbit.guardrails.basedir>
                           <qbit.guardrails.outputDirectory>${project.build.outputDirectory}</qbit.guardrails.outputDirectory>
                           <qbit.guardrails.testOutputDirectory>${project.build.testOutputDirectory}</qbit.guardrails.testOutputDirectory>
                           <qbit.guardrails.enforce>${qbit.guardrails.enforce}</qbit.guardrails.enforce>
                           <qbit.guardrails.allowedQbitArtifacts>${qbit.guardrails.allowedQbitArtifacts}</qbit.guardrails.allowedQbitArtifacts>
                           <qbit.guardrails.allowedApiPackages>${qbit.guardrails.allowedApiPackages}</qbit.guardrails.allowedApiPackages>
                           <qqq.uiApi.strictRoutes>${qbit.guardrails.strictUiApiRoutes}</qqq.uiApi.strictRoutes>
                        </systemPropertyVariables>
                     </configuration>
                  </plugin>
                  <plugin>
                     <groupId>org.apache.maven.plugins</groupId>
                     <artifactId>maven-enforcer-plugin</artifactId>
                     <version>3.6.3</version>
                     <configuration>
                        <fail>${qbit.guardrails.enforce}</fail>
                        <failFast>false</failFast>
                        <rules>
                           <bannedDependencies>
                              <message>[qbit-guardrails] G1-deps: cross-qbit implementation dependencies</message>
                              <searchTransitive>true</searchTransitive>
                              <excludes>
                                 <exclude>com.kingsrook.qbits:*:*:*:compile</exclude>
                                 <exclude>com.kingsrook.qbits:*:*:*:runtime</exclude>
                                 <exclude>com.kingsrook.qbits:*:*:*:provided</exclude>
                                 <exclude>com.kingsrook.qbits:*:*:*:system</exclude>
                              </excludes>
                              <includes>${qbit.guardrails.allowedQbitArtifacts}</includes>
                           </bannedDependencies>
                           <requireReleaseDeps>
                              <message>[qbit-guardrails] G7: QQQ and qbit dependencies must not be SNAPSHOTs</message>
                              <onlyWhenRelease>false</onlyWhenRelease>
                              <failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
                              <searchTransitive>true</searchTransitive>
                              <!-- Includes re-enable checks within exclusions in Enforcer 3.6.3. -->
                              <excludes><exclude>*:*</exclude></excludes>
                              <includes>
                                 <include>com.kingsrook.qqq:*</include>
                                 <include>com.kingsrook.qbits:*</include>
                              </includes>
                           </requireReleaseDeps>
                        </rules>
                     </configuration>
                  </plugin>
               </plugins>
            </pluginManagement>
            <plugins>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-surefire-plugin</artifactId>
               </plugin>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-enforcer-plugin</artifactId>
                  <executions>
                     <execution>
                        <id>qbit-architecture-guardrails</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                     </execution>
                     <!-- Enforcer's transitive resolver omits optional direct dependencies. -->
                     <execution>
                        <id>qbit-direct-architecture-guardrails</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                           <rules>
                              <bannedDependencies><searchTransitive>false</searchTransitive></bannedDependencies>
                              <requireReleaseDeps><searchTransitive>false</searchTransitive></requireReleaseDeps>
                           </rules>
                        </configuration>
                     </execution>
                  </executions>
               </plugin>
            </plugins>
         </build>
      </profile>
      <!-- Release profile for Maven Central -->
      <profile>
         <id>release</id>
         <build>
            <plugins>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-source-plugin</artifactId>
                  <version>3.3.0</version>
                  <executions>
                     <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar</goal></goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-javadoc-plugin</artifactId>
                  <version>3.6.2</version>
                  <configuration>
                     <failOnError>false</failOnError>
                     <doclint>none</doclint>
                  </configuration>
                  <executions>
                     <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-gpg-plugin</artifactId>
                  <version>3.2.4</version>
                  <configuration>
                     <keyname>${gpg.keyname}</keyname>
                     <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                     </gpgArguments>
                  </configuration>
                  <executions>
                     <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals><goal>sign</goal></goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.sonatype.central</groupId>
                  <artifactId>central-publishing-maven-plugin</artifactId>
                  <version>0.8.0</version>
                  <extensions>true</extensions>
                  <configuration>
                     <publishingServerId>central</publishingServerId>
                     <autoPublish>true</autoPublish>
                     <waitUntil>uploaded</waitUntil>
                  </configuration>
               </plugin>
            </plugins>
         </build>
      </profile>
   </profiles>

   <repositories>
     <repository>
       <id>central-portal-snapshots</id>
       <name>Central Portal Snapshots</name>
       <url>https://central.sonatype.com/repository/maven-snapshots/</url>
       <releases>
         <enabled>false</enabled>
       </releases>
       <snapshots>
         <enabled>true</enabled>
       </snapshots>
     </repository>
   </repositories>
</project>
